				<objectChange node="wheelLoaderFork_vis_2" visibilityActive="true" visibilityInactive="false"/>
			</inputAttacherJoint>
            <inputAttacherJoint node="attacherJoint_WL_3" jointType="wheelLoader">
				<objectChange node="wheelLoaderFork_vis_3" visibilityActive="true" visibilityInactive="false"/>
