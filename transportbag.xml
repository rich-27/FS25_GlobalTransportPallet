			</inputAttacherJoint>
            <inputAttacherJoint node="attacherJoint_FL_0" jointType="frontloader">
				<objectChange node="frontloaderPalletFork_vis_0" visibilityActive="true" visibilityInactive="false"/>
			</inputAttacherJoint>
            <inputAttacherJoint node="attacherJoint_FL_1" jointType="frontloader">
				<objectChange node="frontloaderPalletFork_vis_1" visibilityActive="true" visibilityInactive="false"/>
			</inputAttacherJoint>
            <inputAttacherJoint node="attacherJoint_FL_2" jointType="frontloader">
				<objectChange node="frontloaderPalletFork_vis_2" visibilityActive="true" visibilityInactive="false"/>
			</inputAttacherJoint>
            <inputAttacherJoint node="attacherJoint_FL_3" jointType="frontloader">
				<objectChange node="frontloaderPalletFork_vis_3" visibilityActive="true" visibilityInactive="false"/>
