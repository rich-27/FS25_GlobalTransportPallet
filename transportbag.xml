            <inputAttacherJoint node="attacherJoint_SS_0" jointType="skidSteer">
				<objectChange node="paladinPalletFork_vis_0" visibilityActive="true" visibilityInactive="false"/>
			</inputAttacherJoint>
            <inputAttacherJoint node="attacherJoint_SS_1" jointType="skidSteer">
				<objectChange node="paladinPalletFork_vis_1" visibilityActive="true" visibilityInactive="false"/>
			</inputAttacherJoint>
            <inputAttacherJoint node="attacherJoint_SS_2" jointType="skidSteer">
				<objectChange node="paladinPalletFork_vis_2" visibilityActive="true" visibilityInactive="false"/>
			</inputAttacherJoint>
            <inputAttacherJoint node="attacherJoint_SS_3" jointType="skidSteer">
