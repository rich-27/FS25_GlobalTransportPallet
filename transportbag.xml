    </attachable>

    <animations>
        <animation name="bigBagSizeAnimation">
            <part node="top_modifier" 		startTime="0.0" endTime="1.0" startTrans="0 -0.644 0" endTrans="0 0.671 0" />
            <part node="middle_modifier" 	startTime="0.0" endTime="1.0" startTrans="0 -0.625 0" endTrans="0 0.121 0" />
        </animation>
    </animations>
	
    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration name="$l10n_configuration_valueDefault">
                <fillUnits fillTypeChangeThreshold="0">
                    <fillUnit shopDisplayUnit="CUBICMETER" fillTypeCategories="BULK LOC_SA LOC_PRODUCTS LOC_PLATINUM LOC_BIGBAGS LOC_GRAINMILL LOC_PACKING LOC_FARMPROD LOC_DONUT LOC_OTHERS LOC_SEEDPOTATO LOC_PAPER LOC_PLANTY LOC_BARREL" capacity="10000" updateMass="false" allowAILoading="true">
                        <dashboard displayType="ANIMATION" valueType="fillLevel" animName="bigBagSizeAnimation"/>
						<exactFillRootNode node="exactFillRootNode" />
						<autoAimTargetNode node="fillAutoAimTarget1" startZ="0.9" endZ="-2.8" invert="false" fillUnitIndex="1" startPercentage="25"/>
                    </fillUnit>
                </fillUnits>
            </fillUnitConfiguration>
            <fillUnitConfiguration name="$l10n_configuration_valueUnreal">
                <fillUnits fillTypeChangeThreshold="0">
					<fillUnit shopDisplayUnit="CUBICMETER" fillTypeCategories="BULK LOC_SA LOC_PRODUCTS LOC_PLATINUM LOC_BIGBAGS LOC_GRAINMILL LOC_PACKING LOC_FARMPROD LOC_DONUT LOC_OTHERS LOC_SEEDPOTATO LOC_PAPER LOC_PLANTY LOC_BARREL" capacity="200000" updateMass="false" allowAILoading="true">
                        <dashboard displayType="ANIMATION" valueType="fillLevel" animName="bigBagSizeAnimation"/>
						<exactFillRootNode node="exactFillRootNode" />
						<autoAimTargetNode node="fillAutoAimTarget1" startZ="0.9" endZ="-2.8" invert="false" fillUnitIndex="1" startPercentage="25"/>
                    </fillUnit>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

	<dischargeable requiresTipOcclusionArea="false">
        <dischargeNode node="dischargeNode" emptySpeed="1500" fillUnitIndex="1" maxDistance="6" canStartDischargeAutomatically="true" playSound="true">
		
			<stateObjectChanges>
				<objectChange node="bigbag_dispenser" visibilityActive="true" visibilityInactive="false"/>
			</stateObjectChanges>

			<distanceObjectChanges threshold="0.3">
				<objectChange node="bigbag_dispenser" visibilityActive="true" visibilityInactive="false"/>
			</distanceObjectChanges>

			<effects>
				<effectNode effectClass="PipeEffect" effectNode="pipeEffect"  materialType="pipe"           delay="0"   maxBending="1"  positionUpdateNodes="smokeEffect"/>
				<effectNode                          effectNode="smokeEffect" materialType="unloadingSmoke" delay="0.1" alignToWorldY="true"/>
			</effects>
		</dischargeNode>
    </dischargeable>
	
	<ai>
        <allowTurnBackward value="false"/>
        <agentAttachment width="2.7" height="3" length="2" lengthOffset="1.0"/>
    </ai>

	<tensionBeltObject>
        <meshNodes>
            <meshNode node="col_top"/>
        </meshNodes>
    </tensionBeltObject>
	
	<suspensions>
        <suspension node="top_modifier_susp" weight="250" maxTranslation="0.1 0.1 0.1" minTranslation="-0.1 -0.1 -0.1" maxRotation="2 2 2" minRotation="-2 -2 -2" suspensionParametersX="20 4" suspensionParametersY="20 4" suspensionParametersZ="20 4" />
        <suspension node="middle_modifier_susp" weight="150" maxTranslation="0.1 0.1 0.1" minTranslation="-0.1 -0.1 -0.1" suspensionParametersX="20 4" suspensionParametersY="20 4" suspensionParametersZ="20 4" />
    </suspensions>
	
    <fillTriggerVehicle triggerNode="fillTrigger" fillUnitIndex="1" litersPerSecond="2000"/>

	<dynamicMount triggerNode="dynamicMountTrigger" triggerForceAcceleration="4" additionalMountDistance="0.45" jointTransY="0.11" jointLimitToRotY="true"/>

