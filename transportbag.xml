    <storeData>
		<name>
			<en>Global Goods Transport Bag</en>
			<de>Globale Warentransport-Bag</de>
			<es>Saca De Transporte De Mercancías Global</es>
		</name>
        <functions>
            <function>$l10n_function_globalbag</function>
        </functions>
        <specs>
            <weight ignore="true"/>
        </specs>
        <image>store_transportbag.png</image>
        <price>1000</price>
        <lifetime>600</lifetime>
        <rotation>0</rotation>
        <brand>LIZARDGOODS</brand>
        <category>bigbags</category>
        <financeCategory>OTHER</financeCategory>
        <shopHeight>2</shopHeight>
        <shopTranslationOffset>0 0.2 0</shopTranslationOffset>
        <vertexBufferMemoryUsage>378880</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>70144</indexBufferMemoryUsage>
        <textureMemoryUsage>3997696</textureMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <typeDesc>$l10n_typeDesc_pallet</typeDesc>
        <filename>transportbag.i3d</filename>
        <size width="4" length="4" height="4"/>
        <supportsPickUp>true</supportsPickUp>
        <components maxMass="850">
            <component centerOfMass="0 0.1 0" solverIterationCount="40" mass="150" />
        </components>
        <mapHotspot available="false" />
        <schemaOverlay attacherJointPosition="0 0" name="IMPLEMENT" />
    </base>

    <attachable>
        <inputAttacherJoints>
            <inputAttacherJoint node="attacherJoint_TH_0" jointType="telehandler">
				<objectChange node="telehandlerFork_vis_0" visibilityActive="true" visibilityInactive="false"/>
			</inputAttacherJoint>
            <inputAttacherJoint node="attacherJoint_TH_1" jointType="telehandler">
				<objectChange node="telehandlerFork_vis_1" visibilityActive="true" visibilityInactive="false"/>
			</inputAttacherJoint>
