				<objectChange node="telehandlerFork_vis_2" visibilityActive="true" visibilityInactive="false"/>
			</inputAttacherJoint>
            <inputAttacherJoint node="attacherJoint_TH_3" jointType="telehandler">
				<objectChange node="telehandlerFork_vis_3" visibilityActive="true" visibilityInactive="false"/>
			</inputAttacherJoint>
            <inputAttacherJoint node="attacherJoint_WL_0" jointType="wheelLoader">
				<objectChange node="wheelLoaderFork_vis_0" visibilityActive="true" visibilityInactive="false"/>
			</inputAttacherJoint>
            <inputAttacherJoint node="attacherJoint_WL_1" jointType="wheelLoader">
				<objectChange node="wheelLoaderFork_vis_1" visibilityActive="true" visibilityInactive="false"/>
			</inputAttacherJoint>
